#!/usr/bin/env bash

BIN_NAME=$(basename "$0")
COMMAND_NAME=$1

# Get dotfiles dir (so run this script from anywhere)
SOURCE="${BASH_SOURCE[0]}"
if [[ -L "$SOURCE" ]]; then
    TARGET="$(readlink "$SOURCE")"
    [[ "$TARGET" == /* ]] && SOURCE="$TARGET" || SOURCE="$(dirname "$SOURCE")/$TARGET"
fi
export DOTFILES_DIR EXTRA_DIR
DOTFILES_DIR="$(cd "$(dirname "$SOURCE")/.." && pwd)"
# shellcheck source=../scripts/lib/output.sh
source "$DOTFILES_DIR/scripts/lib/output.sh"

# Prefer the synced venv (fast path, no resolver); fall back to uv run, which
# can provision or heal the environment when the venv is missing or broken.
cli_python () {
    local py="$DOTFILES_DIR/cli/.venv/bin/python"
    if [[ -x "$py" ]]; then
        "$py" "$@"
    else
        uv run --project "$DOTFILES_DIR/cli" python "$@"
    fi
}

cli_dotfiles () {
    local bin="$DOTFILES_DIR/cli/.venv/bin/dotfiles"
    if [[ -x "$bin" ]]; then
        exec "$bin" "$@"
    fi
    exec uv run --project "$DOTFILES_DIR/cli" dotfiles "$@"
}

sub_help () {
    # Typer owns help formatting; the root group adds the canonical banner.
    local error="${1:-}"
    if [[ -n "$error" ]]; then
        printf "Error: %s\n\n" "$error" >&2
        cli_python -m dotfiles.app.main --help >&2 \
            || printf "Usage: %s <command>\n" "$BIN_NAME" >&2
        return
    fi
    cli_python -m dotfiles.app.main --help 2>/dev/null \
        || printf "Usage: %s <command> (run \`dfs doctor\` — Python CLI unreachable)\n" "$BIN_NAME"
}

sub_update () {
    "$DOTFILES_DIR/scripts/update.sh"
}

sub_dock () {
    . "$DOTFILES_DIR/scripts/macos/dock.sh"
    print_success "macOS Dock configured"
}

sub_install() {
    . "$DOTFILES_DIR/install.sh"
}

sub_shell_profile () {
    "$DOTFILES_DIR/scripts/profile-shell.sh"
}

# Every Python command must also appear in the Typer registry and zsh completion;
# app/test_command_tree.py enforces the routing contract.
PY_CLI_COMMANDS=" remote doctor brew credential password clean "
if [[ -n "${1:-}" && "$PY_CLI_COMMANDS" == *" $1 "* ]]; then
    cli_dotfiles "$@"
fi

# Bash-native commands accept no arguments. Route their help through Typer so
# `dfs install --help` can never enter the installer, and reject every other
# argument before dispatch for the same reason.
BASH_NATIVE_COMMANDS=" install update dock profile-shell "
if [[ -n "${1:-}" && "$BASH_NATIVE_COMMANDS" == *" $1 "* && "${2:-}" == "--help" ]]; then
    cli_dotfiles "$@"
fi
if [[ -n "${1:-}" && "$BASH_NATIVE_COMMANDS" == *" $1 "* && "${2:-}" == "-h" ]]; then
    set -- "$1" --help
    cli_dotfiles "$@"
fi
if [[ -n "${1:-}" && "$BASH_NATIVE_COMMANDS" == *" $1 "* && $# -gt 1 ]]; then
    sub_help "Command '$1' accepts no arguments. Run 'dfs $1 --help' for details."
    exit 2
fi

case $COMMAND_NAME in
    "" | "-h" | "--help") sub_help ;;

    # Top-level
    install)     sub_install ;;
    update)      sub_update ;;
    dock)        sub_dock ;;

    # profile-shell is a canonical flat command (Machine group in sub_help)
    profile-shell) shift; sub_shell_profile "$@" ;;

    *) cli_dotfiles "$@" ;;
esac
