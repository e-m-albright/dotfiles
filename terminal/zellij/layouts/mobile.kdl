// Mobile session layout — what the `mobile` Zellij session opens as on first
// creation. Create it once with `zellij --session mobile --layout mobile`
// (detach with Ctrl-o d); persisted after, so this only applies on first creation
// or after `zellij delete-session mobile`. `dfs remote on` reminds you if missing.
//
// compact-bar (instead of the default status-bar) reclaims a row on a phone
// screen. Tab 1 boots Mission Control (the session launcher); tab 2 is a shell.
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="deck" focus=true {
        pane command="dotfiles" {
            args "tui"
        }
    }
    tab name="shell"
}
