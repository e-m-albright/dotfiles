// Zellij — minimal overrides on top of the shipped defaults.
// Source of truth: dotfiles/terminal/zellij/ (symlinked into ~/.config/zellij
// by install.sh). Dump the full default set any time with:
//   zellij setup --dump-config
// Keep this file tiny: only divergences from the defaults belong here.

// Skip the welcome/startup-tips overlay on new sessions.
show_startup_tips false

// Theme — a high-contrast dark theme that also reads well in the phone web client.
theme "catppuccin-mocha"

// Persist sessions to disk so `zellij attach mobile` resurrects the deck after a
// reboot or detach. Pinned explicitly rather than relying on the shifting default.
session_serialization true

// Also serialize each pane's visible scrollback, so a resurrected session (after
// a reboot or quit) comes back with its buffer instead of blank panes. Capped so
// the on-disk state doesn't balloon. Only affects resurrection — a live detach
// keeps everything regardless.
serialize_pane_viewport true
scrollback_lines_to_serialize 10000

// --- Web client --------------------------------------------------------------
// `dfs remote zellij --start` serves sessions on 127.0.0.1:8082. To reach it
// from the phone, keep it on localhost and put it behind Tailscale:
//   tailscale serve --bg 8082   // tailnet-only HTTPS, terminates TLS for you
// Then open https://<your-tailnet-host>/<session> on the phone (installable as a
// PWA). No need to bind beyond localhost or set web_server_cert/key here.
