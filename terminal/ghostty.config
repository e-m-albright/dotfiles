# Ghostty terminal configuration
# Symlinked to ~/.config/ghostty/config by install.sh

# Notifications — enables OSC 9/777 desktop notifications
# Claude Code uses these when waiting for input
desktop-notifications = true

# OSC 52 requests are executed by the host terminal, outside agent sandboxes.
# Manual copy/paste still works; programs cannot read or silently replace it.
clipboard-read = deny
clipboard-write = ask

# Theme
theme = Dracula

# Font
font-size = 14
# Fira Code with all Nerd Font glyphs baked in (statusline icons, devicons,
# powerline arrows). Installed via macos/packages.toml fonts entries.
# The "Mono" suffix constrains icon glyphs to fixed-width cells; the non-Mono
# variant uses 2x cells for icons and breaks terminal layout.
font-family = "FiraCode Nerd Font Mono"

# Window
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# Treat Option as Alt so Option-Delete and other shell word-editing bindings
# send terminal escape sequences instead of macOS Unicode input.
macos-option-as-alt = true

# Shell integration
shell-integration = zsh

# Window/tab state restoration
# `always` saves state on every quit so a relaunch (or system reboot)
# reopens the same windows, tabs, splits, and working directories.
# State lives in ~/Library/Saved Application State/com.mitchellh.ghostty.savedState/
# Caveats: tab titles aren't preserved; an unexpected power loss / kernel panic
# may not flush state. For graceful quits and normal reboots this works.
window-save-state = always

# New tabs/windows inherit the cwd of the focused tab (helps post-restore too)
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
